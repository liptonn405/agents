# Скопируйте в .env и заполните своими значениями.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-v4.1-flash

# Необязательно: путь к клонированному репозиторию Miminet.
# ANALYST_REPO=../miminet

# Необязательно: каталог автосохранения результатов.
# ANALYST_OUTPUT_DIR=/home/user/coursework/sem2/analyst_artifacts

# Необязательно: отдельный файл с переменными.
# ANALYST_ENV_FILE=/absolute/path/to/analyst.env
